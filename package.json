{
  "name": "thrivo-public",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "cross-env PLAYWRIGHT_USE_WEBSERVER=1 playwright test --grep @smoke --project=chromium",
    "test:e2e:a11y": "cross-env PLAYWRIGHT_USE_WEBSERVER=1 playwright test tests/e2e/a11y-critical-journeys.spec.ts --project=chromium",
    "test:phase": "vitest run --config vitest.phase.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "analyze": "cross-env ANALYZE=true next build --turbopack",
    "generate:og-image": "node scripts/generate-og-image.mjs",
    "clean:next": "node -e \"fs.rmSync('.next',{recursive:true,force:true})\"",
    "checks": "npm run lint && npm run format:check && npm run test:unit && npm run clean:next && npm run build",
    "audit": "npm audit",
    "audit:ci": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@beorchid-llc/thrivo-contracts": "^0.11.0",
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "motion": "^12.40.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@next/bundle-analyzer": "^16.2.7",
    "@playwright/test": "^1.58.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.19.20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "satori": "^0.26.0",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.8",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "wawoff2": "^2.0.1"
  }
}
