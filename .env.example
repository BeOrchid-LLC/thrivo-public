# Public site canonical origin (also inlined into the client bundle at Docker build time)
NEXT_PUBLIC_LIVE_URL=https://thrivo.fit

# Backend API origin (email-capture form, future API calls)
NEXT_PUBLIC_API_URL=https://api.thrivo.fit

# Native app destinations shown by the Universal/App Link fallback pages.
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idREPLACE_ME
NEXT_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=com.beorchid.thrivo

# Server-only association credentials. Deploy the production values before
# enabling HTTPS email CTAs or publishing the corresponding native build.
APPLE_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
ANDROID_SHA256_CERT_FINGERPRINTS=REPLACE_WITH_PRODUCTION_SHA256_FINGERPRINT

# Observability (optional)
# NEXT_PUBLIC_ENABLE_WEB_VITALS=1
# NEXT_PUBLIC_SENTRY_DSN=

# Branded splash screen (optional). Off by default everywhere (protects LCP/INP
# and conversion — blocks pointer events while shown). Set to true to opt in.
# NEXT_PUBLIC_ENABLE_SPLASH=
